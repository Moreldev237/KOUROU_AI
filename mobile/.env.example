# Copier ce fichier en ".env" à la racine de mobile/.
#
# Expo n'expose au code client QUE les variables préfixées EXPO_PUBLIC_ (elles
# sont intégrées au bundle à la compilation — ne jamais y mettre de secret,
# uniquement des valeurs déjà publiques comme une URL d'API).

# URL du backend Django.
# Utiliser l'IP locale de votre machine sur le réseau Wi‑Fi pour Expo Go
# ou un téléphone physique. Exemple : http://192.168.1.20:8000
# Avec l'émulateur Android, vous pouvez aussi utiliser : http://10.0.2.2:8000
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.235:8000

