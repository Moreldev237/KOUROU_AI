# ==============================================================================
# KOUROU AI — Variables d'environnement (backend)
# Copier ce fichier en ".env" et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).
# ==============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=change-moi-avec-une-cle-secrete-aleatoire-longue
ALLOWED_HOSTS=localhost,127.0.0.1
# Domaines autorisés à appeler l'API depuis un navigateur (le mobile Expo n'est pas
# concerné par CORS car ce n'est pas un navigateur, mais on le garde pour un futur
# client web ou pour Expo Web / le simulateur).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Base de données PostgreSQL ---
POSTGRES_DB=kourou_ai
POSTGRES_USER=kourou_ai
POSTGRES_PASSWORD=change-moi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- E-mail / SMTP ---
# Utilisez un fournisseur SMTP réel (Gmail, Outlook, SendinBlue, etc.) pour envoyer
# les emails de réinitialisation de mot de passe.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=moreldev237@gmail.com
EMAIL_HOST_PASSWORD=kacasmnchdhthkof
DEFAULT_FROM_EMAIL=no-reply@kourou-ai.com


# --- Redis (cache applicatif + broker Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Google Gemini API ---
# Clé obtenue sur https://aistudio.google.com/apikey — reste STRICTEMENT côté
# serveur, jamais transmise au frontend mobile.
GEMINI_API_KEY=your-gemini-api-key
# Nom du modèle utilisé pour la génération. Les noms de modèles Gemini évoluent
# régulièrement (ex: gemini-2.0-flash, gemini-2.5-flash, gemini-3.x-flash...).
# Vérifier la liste courante sur https://ai.google.dev/gemini-api/docs/models
# avant mise en production, et ajuster ici sans toucher au code.
GEMINI_MODEL_NAME=gemini-2.5-flash
# Active la mise en cache de contexte native de Gemini (en plus du cache
# applicatif PostgreSQL/Redis qui reste la première ligne de défense).
GEMINI_ENABLE_CONTEXT_CACHING=True

# --- Passerelle de paiement Mobile Money (CinetPay par défaut) ---
# Voir https://docs.cinetpay.com — le module payments/gateways/ est conçu pour
# qu'on puisse ajouter Monetbil ou Notch Pay en implémentant la même interface.
PAYMENT_GATEWAY=cinetpay
CINETPAY_API_KEY=your-cinetpay-apikey
CINETPAY_SITE_ID=your-cinetpay-site-id
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_CURRENCY=XAF
# URL publique HTTPS que CinetPay appellera pour notifier des changements de
# statut de paiement (doit être accessible depuis Internet, donc inutilisable
# en localhost pur — utiliser ngrok/cloudflared en développement).
PAYMENT_NOTIFY_URL=https://votre-domaine.com/api/payments/webhook/cinetpay/
PAYMENT_RETURN_URL=https://votre-domaine.com/paiement/retour

# --- Quotas ---
FREE_DAILY_GENERATION_LIMIT=10

# --- Notifications (OTP par SMS) ---
# En développement, le backend "console" écrit simplement le code OTP dans les
# logs. Remplacer par un vrai fournisseur SMS local avant la mise en production.
SMS_BACKEND=console
