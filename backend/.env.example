
# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=change-moi-avec-une-cle-secrete-aleatoire-longue
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.0.235
# Domaines autorisés à appeler l'API depuis un navigateur (le mobile Expo n'est pas
# concerné par CORS car ce n'est pas un navigateur, mais on le garde pour un futur
# client web ou pour Expo Web / le simulateur).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# --- Base de données PostgreSQL ---
POSTGRES_DB=kourou_ai
POSTGRES_USER=kourou_ai
POSTGRES_PASSWORD=qwerty
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache applicatif + broker Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Google Gemini API ---
# Clé obtenue sur https://aistudio.google.com/apikey — reste STRICTEMENT côté
# serveur, jamais transmise au frontend mobile.
GEMINI_API_KEY=ma-cle-api-gemini-obtenue-sur-google-aistudio
# Modèle utilisé si le modèle principal renvoie temporairement un 503.
GEMINI_FALLBACK_MODEL_NAME=gemini-3.6-flash

# --- E-mail / SMTP ---
# Utilisez un fournisseur SMTP réel (Gmail, Outlook, SendinBlue, etc.) pour envoyer
# les emails de réinitialisation de mot de passe.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=moreldev237@gmail.com
EMAIL_HOST_PASSWORD=kacasmnchdhthkof
DEFAULT_FROM_EMAIL=no-reply@kourou-ai.com
# Nom du modèle utilisé pour la génération. Les noms de modèles Gemini évoluent
# régulièrement (ex: gemini-2.0-flash, gemini-2.5-flash, gemini-3.x-flash...).
# Vérifier la liste courante sur https://ai.google.dev/gemini-api/docs/models
# avant mise en production, et ajuster ici sans toucher au code.
GEMINI_MODEL_NAME=gemini-3.8-flash
# Active la mise en cache de contexte native de Gemini (en plus du cache
# applicatif PostgreSQL/Redis qui reste la première ligne de défense).
GEMINI_ENABLE_CONTEXT_CACHING=True

# --- Passerelle de paiement Mobile Money (KPay) ---
PAYMENT_GATEWAY=kpay
KPAY_API_KEY=your-kpay-api-key
KPAY_SECRET_KEY=your-kpay-secret-key
KPAY_WEBHOOK_SECRET=your-kpay-webhook-secret
KPAY_BASE_URL=https://admin.kpay.site
KPAY_CURRENCY=XAF
# URL publiques HTTPS configurées dans l'application KPay.
PAYMENT_NOTIFY_URL=https://votre-domaine.com/api/payments/webhook/kpay/
PAYMENT_RETURN_URL=https://votre-domaine.com/paiement/retour
PAYMENT_CANCEL_URL=https://votre-domaine.com/paiement/annule

# --- Quotas ---
FREE_DAILY_GENERATION_LIMIT=5

